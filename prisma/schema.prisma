generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Currency {
  USD
  CDF
}

enum Role {
  ADMIN
  CONTROLLER
  DIRECTOR
  CASHIER
  REQUESTER
  VIEWER
}

/// Organisation = un client de la plateforme (tenant). Toutes ses données sont isolées par Row-Level Security.
model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Entity {
  organizationId String           @default(dbgenerated("current_setting('app.org_id'::text, true)"))
  id             String           @id @default(cuid())
  code           String // ex. SEC, ECOLE : sélecteur d'entité (unique par organisation)
  prefix         String // préfixe des références (SEC-DF-2026-00001), unique par organisation
  name           String
  roles          UserEntityRole[]
  accounts       Account[]

  @@index([organizationId])
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  fullName        String
  passwordHash    String
  isActive        Boolean          @default(true)
  /// null = administrateur de la plateforme (aucun accès aux données financières d'une organisation)
  organizationId  String?          @default(dbgenerated("current_setting('app.org_id'::text, true)"))
  isPlatformAdmin Boolean          @default(false)
  totpSecretEnc   String?
  totpEnabledAt   DateTime?
  roles           UserEntityRole[]
  sessions        Session[]
  createdAt       DateTime         @default(now())
}

model UserEntityRole {
  organizationId String @default(dbgenerated("current_setting('app.org_id'::text, true)"))
  userId         String
  entityId       String
  role           Role
  user           User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  entity         Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@id([userId, entityId, role])
  @@index([organizationId])
}

model Session {
  id          String    @id // sha256 du token aléatoire
  userId      String
  expiresAt   DateTime
  lastSeenAt  DateTime
  ip          String?
  userAgent   String?
  stepUpUntil DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model LoginEvent {
  id        String   @id @default(cuid())
  userId    String?
  email     String
  success   Boolean
  ip        String?
  userAgent String?
  at        DateTime @default(now())

  @@index([email, at])
}

model AuditLog {
  organizationId String?  @default(dbgenerated("current_setting('app.org_id'::text, true)"))
  id             String   @id @default(cuid())
  actorId        String?
  action         String
  entityType     String
  entityId       String
  before         Json?
  after          Json?
  ip             String?
  at             DateTime @default(now())

  @@index([entityType, entityId])
  @@index([organizationId])
}

enum AccountType {
  CASH
  BANK
}

enum TxKind {
  OPENING_BALANCE
  INCOME
  EXPENSE
  CASH_TO_BANK
  BANK_TO_CASH
  BANK_TO_BANK
  CASH_TO_CASH
  BANK_FEE
  ADVANCE_DISBURSEMENT
  ADVANCE_REPAYMENT
  CASH_ADJUSTMENT
  REVERSAL
}

enum TxStatus {
  POSTED
  REVERSED
}

// Caisse OU compte bancaire : une seule devise par compte.
model Account {
  organizationId     String        @default(dbgenerated("current_setting('app.org_id'::text, true)"))
  id                 String        @id @default(cuid())
  entityId           String
  type               AccountType
  name               String
  currency           Currency
  bankName           String?
  holderName         String?
  accountNumberEnc   String? // AES-256-GCM, affiché masqué
  accountNumberLast4 String?
  allowOverdraft     Boolean       @default(false) // §13.5 : découvert refusé par défaut
  isActive           Boolean       @default(true)
  openedAt           DateTime
  createdAt          DateTime      @default(now())
  entity             Entity        @relation(fields: [entityId], references: [id])
  entries            LedgerEntry[]

  @@index([entityId, type])
  @@index([organizationId])
}

// Une opération métier = 1 transaction comptable = N écritures.
model FinancialTransaction {
  organizationId String        @default(dbgenerated("current_setting('app.org_id'::text, true)"))
  id             String        @id @default(cuid())
  reference      String
  entityId       String // entité qui porte l'opération (pour une avance : celle qui décaisse)
  kind           TxKind
  date           DateTime
  description    String
  status         TxStatus      @default(POSTED)
  reversalOfId   String?       @unique // renseigné sur la contre-passation : id de l'originale
  reversalReason String?
  createdById    String
  createdAt      DateTime      @default(now())
  // Liens métier (modules des phases suivantes)
  fundRequestId  String?
  incomeId       String?
  expenseId      String?
  advanceId      String?
  entries        LedgerEntry[]
  fx             FxConversion?

  @@unique([organizationId, reference])
  @@index([entityId, date])
  @@index([kind])
  @@index([organizationId])
}

model LedgerEntry {
  organizationId String               @default(dbgenerated("current_setting('app.org_id'::text, true)"))
  id             String               @id @default(cuid())
  txId           String
  accountId      String
  amount         Decimal              @db.Decimal(18, 2) // signé : + entrée, − sortie, devise du compte
  currency       Currency
  createdAt      DateTime             @default(now())
  tx             FinancialTransaction @relation(fields: [txId], references: [id])
  account        Account              @relation(fields: [accountId], references: [id])

  @@index([accountId, createdAt])
  @@index([txId])
  @@index([organizationId])
}

model FxConversion {
  organizationId String               @default(dbgenerated("current_setting('app.org_id'::text, true)"))
  id             String               @id @default(cuid())
  txId           String               @unique
  fromAmount     Decimal              @db.Decimal(18, 2)
  fromCurrency   Currency
  toAmount       Decimal              @db.Decimal(18, 2)
  toCurrency     Currency
  rate           Decimal              @db.Decimal(18, 6) // 1 fromCurrency = rate toCurrency
  rateDate       DateTime
  rateSource     String
  tx             FinancialTransaction @relation(fields: [txId], references: [id])

  @@index([organizationId])
}

model ExchangeRate {
  organizationId String   @default(dbgenerated("current_setting('app.org_id'::text, true)"))
  id             String   @id @default(cuid())
  date           DateTime
  base           Currency
  quote          Currency
  rate           Decimal  @db.Decimal(18, 6)
  source         String
  createdById    String
  createdAt      DateTime @default(now())

  @@unique([organizationId, date, base, quote, source])
  @@index([organizationId])
}

model ReferenceCounter {
  organizationId String @default(dbgenerated("current_setting('app.org_id'::text, true)"))
  entityId       String
  docType        String
  year           Int
  lastValue      Int

  @@id([entityId, docType, year])
  @@index([organizationId])
}

model IdempotencyKey {
  id             String   @id @default(cuid())
  userId         String
  key            String
  method         String
  path           String
  responseStatus Int?
  responseBody   String?
  createdAt      DateTime @default(now())

  @@unique([userId, key])
}

enum FundRequestStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  ESCALATED
  APPROVED
  REJECTED
  DISBURSED
  RECEIVED
  JUSTIFIED
  CLOSED
  CANCELLED
}

enum ApprovalLevel {
  CONTROLLER
  DIRECTOR
}

enum CategoryKind {
  INCOME
  EXPENSE
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
  MOBILE_MONEY
  OTHER
}

enum AttachmentKind {
  RECEIPT
  INVOICE
  SIGNED_REGISTER
  BANK_STATEMENT
  OTHER
}

model Department {
  organizationId String @default(dbgenerated("current_setting('app.org_id'::text, true)"))
  id             String @id @default(cuid())
  entityId       String
  name           String

  @@unique([entityId, name])
  @@index([organizationId])
}

model Category {
  organizationId String       @default(dbgenerated("current_setting('app.org_id'::text, true)"))
  id             String       @id @default(cuid())
  entityId       String
  kind           CategoryKind
  name           String
  isActive       Boolean      @default(true)

  @@unique([entityId, kind, name])
  @@index([organizationId])
}

model Income {
  organizationId String        @default(dbgenerated("current_setting('app.org_id'::text, true)"))
  id             String        @id @default(cuid())
  reference      String
  entityId       String
  date           DateTime
  source         String
  categoryId     String
  amount         Decimal       @db.Decimal(18, 2)
  currency       Currency
  paymentMethod  PaymentMethod
  accountId      String
  note           String?
  createdById    String
  createdAt      DateTime      @default(now())

  @@unique([organizationId, reference])
  @@index([entityId, date])
  @@index([organizationId])
}

model Expense {
  organizationId String        @default(dbgenerated("current_setting('app.org_id'::text, true)"))
  id             String        @id @default(cuid())
  reference      String
  entityId       String
  date           DateTime
  categoryId     String
  departmentId   String?
  beneficiary    String
  purpose        String
  amount         Decimal       @db.Decimal(18, 2)
  currency       Currency
  paymentMethod  PaymentMethod
  accountId      String
  fundRequestId  String?
  createdById    String
  createdAt      DateTime      @default(now())

  @@unique([organizationId, reference])
  @@index([entityId, date])
  @@index([organizationId])
}

model FundRequest {
  organizationId         String             @default(dbgenerated("current_setting('app.org_id'::text, true)"))
  id                     String             @id @default(cuid())
  reference              String
  entityId               String // entité bénéficiaire de la dépense
  requesterId            String
  departmentId           String?
  amount                 Decimal            @db.Decimal(18, 2)
  currency               Currency
  purpose                String
  status                 FundRequestStatus  @default(DRAFT)
  submittedAt            DateTime?
  approvalLevel          ApprovalLevel?
  approvedById           String?
  approvedAt             DateTime?
  disbursedFromAccountId String?
  disbursedById          String?
  disbursedAt            DateTime?
  receivedAt             DateTime?
  closedById             String?
  closedAt               DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  events                 FundRequestEvent[]
  attachments            Attachment[]

  @@unique([organizationId, reference])
  @@index([entityId, status])
  @@index([requesterId])
  @@index([organizationId])
}

model FundRequestEvent {
  organizationId String             @default(dbgenerated("current_setting('app.org_id'::text, true)"))
  id             String             @id @default(cuid())
  fundRequestId  String
  fromStatus     FundRequestStatus?
  toStatus       FundRequestStatus
  actorId        String
  comment        String?
  at             DateTime           @default(now())
  fundRequest    FundRequest        @relation(fields: [fundRequestId], references: [id])

  @@index([fundRequestId])
  @@index([organizationId])
}

model ApprovalLimit {
  organizationId String   @default(dbgenerated("current_setting('app.org_id'::text, true)"))
  id             String   @id @default(cuid())
  entityId       String
  role           Role
  currency       Currency
  maxAmount      Decimal  @db.Decimal(18, 2)

  @@unique([entityId, role, currency])
  @@index([organizationId])
}

model Notification {
  organizationId String    @default(dbgenerated("current_setting('app.org_id'::text, true)"))
  id             String    @id @default(cuid())
  userId         String
  title          String
  body           String
  href           String?
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([userId, readAt])
  @@index([organizationId])
}

model Setting {
  organizationId String   @default(dbgenerated("current_setting('app.org_id'::text, true)"))
  id             String   @id @default(cuid())
  key            String
  value          String
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, key])
  @@index([organizationId])
}

model Attachment {
  organizationId String         @default(dbgenerated("current_setting('app.org_id'::text, true)"))
  id             String         @id @default(cuid())
  storageKey     String
  fileName       String
  mimeType       String
  size           Int
  sha256         String
  kind           AttachmentKind
  data           Bytes? // stockage en base si aucun bucket S3 n'est configuré
  uploadedById   String
  uploadedAt     DateTime       @default(now())
  entityId       String
  txId           String?
  fundRequestId  String?
  expenseId      String?
  incomeId       String?
  fundRequest    FundRequest?   @relation(fields: [fundRequestId], references: [id])

  @@index([fundRequestId])
  @@index([txId])
  @@index([organizationId])
}

enum PendingTransferStatus {
  IN_TRANSIT
  CONFIRMED
  CANCELLED
}

enum CashSessionStatus {
  PENDING_VALIDATION
  CLOSED
}

// Retrait bancaire en deux temps : "en transit" (aucune écriture) puis confirmation de réception.
model PendingTransfer {
  organizationId  String                @default(dbgenerated("current_setting('app.org_id'::text, true)"))
  id              String                @id @default(cuid())
  reference       String
  entityId        String
  bankAccountId   String
  cashAccountId   String
  amount          Decimal               @db.Decimal(18, 2)
  currency        Currency
  description     String
  status          PendingTransferStatus @default(IN_TRANSIT)
  initiatedById   String
  initiatedAt     DateTime              @default(now())
  confirmedById   String?
  confirmedAt     DateTime?
  cancelledReason String?
  txId            String?

  @@unique([organizationId, reference])
  @@index([entityId, status])
  @@index([organizationId])
}

// Clôture journalière de caisse.
model CashSession {
  organizationId     String            @default(dbgenerated("current_setting('app.org_id'::text, true)"))
  id                 String            @id @default(cuid())
  accountId          String
  date               DateTime          @db.Date // jour local (Africa/Lubumbashi)
  theoreticalBalance Decimal           @db.Decimal(18, 2)
  countedBalance     Decimal           @db.Decimal(18, 2)
  difference         Decimal           @db.Decimal(18, 2)
  justification      String?
  denominations      Json?
  status             CashSessionStatus
  closedById         String
  closedAt           DateTime          @default(now())
  validatedById      String?
  validatedAt        DateTime?
  adjustmentTxId     String?

  @@unique([accountId, date])
  @@index([organizationId])
}

enum AdvanceStatus {
  OPEN
  PARTIALLY_REPAID
  REPAID
  CANCELLED
}

// Avance inter-entités : créance pour le prêteur, dette pour l'emprunteur (jamais une recette ni une dépense commerciale).
model InterEntityAdvance {
  organizationId   String             @default(dbgenerated("current_setting('app.org_id'::text, true)"))
  id               String             @id @default(cuid())
  reference        String
  lenderEntityId   String
  borrowerEntityId String
  amount           Decimal            @db.Decimal(18, 2)
  currency         Currency
  date             DateTime
  fundRequestId    String?
  description      String
  status           AdvanceStatus      @default(OPEN)
  createdById      String
  createdAt        DateTime           @default(now())
  repayments       AdvanceRepayment[]

  @@unique([organizationId, reference])
  @@index([lenderEntityId, status])
  @@index([borrowerEntityId, status])
  @@index([organizationId])
}

model AdvanceRepayment {
  organizationId String             @default(dbgenerated("current_setting('app.org_id'::text, true)"))
  id             String             @id @default(cuid())
  advanceId      String
  txId           String             @unique
  amount         Decimal            @db.Decimal(18, 2) // dans la devise de l'avance
  currency       Currency
  date           DateTime
  advance        InterEntityAdvance @relation(fields: [advanceId], references: [id])

  @@index([advanceId])
  @@index([organizationId])
}

model Budget {
  organizationId String       @default(dbgenerated("current_setting('app.org_id'::text, true)"))
  id             String       @id @default(cuid())
  entityId       String
  name           String
  periodStart    DateTime
  periodEnd      DateTime
  currency       Currency
  createdById    String
  createdAt      DateTime     @default(now())
  lines          BudgetLine[]

  @@index([entityId])
  @@index([organizationId])
}

model BudgetLine {
  organizationId String  @default(dbgenerated("current_setting('app.org_id'::text, true)"))
  id             String  @id @default(cuid())
  budgetId       String
  departmentId   String?
  categoryId     String?
  amount         Decimal @db.Decimal(18, 2)
  budget         Budget  @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@index([budgetId])
  @@index([organizationId])
}

enum ReconStatus {
  IN_PROGRESS
  SUBMITTED
  VALIDATED
}

enum MatchStatus {
  UNMATCHED
  SUGGESTED
  MATCHED
  IGNORED
  CREATED
}

model BankStatement {
  organizationId String              @default(dbgenerated("current_setting('app.org_id'::text, true)"))
  id             String              @id @default(cuid())
  accountId      String
  entityId       String
  periodStart    DateTime
  periodEnd      DateTime
  openingBalance Decimal             @db.Decimal(18, 2)
  closingBalance Decimal             @db.Decimal(18, 2)
  fileName       String
  sha256         String
  fileData       Bytes?
  storageKey     String?
  status         ReconStatus         @default(IN_PROGRESS)
  importedById   String
  importedAt     DateTime            @default(now())
  submittedById  String?
  submittedAt    DateTime?
  validatedById  String?
  validatedAt    DateTime?
  validationNote String?
  lines          BankStatementLine[]

  @@index([accountId])
  @@index([organizationId])
}

model BankStatementLine {
  organizationId  String        @default(dbgenerated("current_setting('app.org_id'::text, true)"))
  id              String        @id @default(cuid())
  statementId     String
  position        Int
  date            DateTime
  label           String
  reference       String?
  amount          Decimal       @db.Decimal(18, 2) // signé du point de vue du compte : + crédit, − débit
  matchStatus     MatchStatus   @default(UNMATCHED)
  matchedEntryId  String?
  matchConfidence Int?
  candidateIds    Json? // écritures candidates proposées (jamais confirmées automatiquement)
  duplicateOfId   String?
  confirmedById   String?
  confirmedAt     DateTime?
  note            String?
  statement       BankStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)

  @@index([statementId])
  @@index([matchedEntryId])
  @@index([organizationId])
}

// Mapping de colonnes mémorisé par compte bancaire.
model BankColumnMapping {
  organizationId String   @default(dbgenerated("current_setting('app.org_id'::text, true)"))
  accountId      String   @id
  mapping        Json
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
}
