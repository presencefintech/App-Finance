# PostgreSQL (Railway : ${{Postgres.DATABASE_URL}} via le réseau privé)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sec_finance"
SESSION_SECRET="généré : node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\""
ENCRYPTION_KEY="64 caractères hexadécimaux (32 octets) — même commande que SESSION_SECRET"
APP_TIMEZONE="Africa/Lubumbashi"
APP_URL="http://localhost:3000"
# Adresse publique utilisée pour l'image d'aperçu des liens partagés (défaut : https://www.fintrax.site)
# SITE_URL="https://www.fintrax.site"

# E-mails (Resend) : optionnel. Sans clé, seules les notifications internes sont actives.
RESEND_API_KEY=""
EMAIL_FROM="Fintrax <noreply@votre-domaine.com>"

# Stockage des justificatifs : bucket S3 compatible (sinon repli en base). Railway : S3_URL_STYLE=virtual-host.
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_REGION="auto"
S3_URL_STYLE="virtual-host"
